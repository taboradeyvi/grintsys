---
// filepath: c:\Users\tabor\Documents\GitHub\grintsys\src\components\Hero.astro
import Whatsapp from "../assets/icons/Whatsapp.astro";
import "../styles/global.css";
---

<section class="relative bg-white dark:bg-gray-900">
  <div
    class="max-w-7xl mx-auto px-4 py-40 lg:flex lg:items-center lg:justify-between"
  >
    <!-- Contenido principal -->
    <div class="text-center lg:text-left">
      <h1
        class="text-4xl font-extrabold tracking-tight text-gray-900 dark:text-white sm:text-5xl"
      >
        POTENCIA TU NEGOCIO
      </h1>
      <h1 class="text-4xl font-extrabold tracking-tight mt-5">
        <span class="text-green-500"
          >Soluciones digitales escalables, personalizables y adaptables a tu
          negocio</span
        >
      </h1>
      <p class="mt-10 text-lg text-gray-200">
        Tenemos la mejor solucion para optimizar su negocio e incrementar sus
        ganancias, maneje su contabilidad, inventarios, ventas y muchos mas.
      </p>
      <div class="mt-6">
        <a
          href="#"
          class="flex gap-x-2 w-fit bg-green-500 text-white font-medium text-lg px-6 py-3 rounded-lg shadow hover:bg-transparent hover:border-green-500 hover:border hover:text-green-500 transition duration-300 ease-in-out"
        >
          <Whatsapp />
          CONTACTANOS
        </a>
      </div>
    </div>

    <!-- Imagen -->
    <div class="mt-10 lg:mt-0 lg:ml-10 max-w-xl">
      <img
        src="https://res.cloudinary.com/highereducation/images/f_auto,q_auto/v1694627620/CyberDegrees.org/typical-day-of-security-software-developer/typical-day-of-security-software-developer.jpg?_i=AA"
        alt="Team working together"
        class="rounded-lg shadow-lg"
      />
    </div>
  </div>
</section>
